From 2ed1231efab036c7bf30207caf141da6abdeea9b Mon Sep 17 00:00:00 2001
From: Krispr bench <bench@krispr.dev>
Date: Wed, 30 Sep 2026 03:24:52 +0000
Subject: [PATCH] Encode U+10000 with four bytes

---
 .../common/src/main/java/com/fsck/k9/mail/helper/Utf8.kt | 2 +-
 .../fsck/k9/mail/internet/MimeParameterEncoderTest.kt    | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/mail/common/src/main/java/com/fsck/k9/mail/helper/Utf8.kt b/mail/common/src/main/java/com/fsck/k9/mail/helper/Utf8.kt
index a8c20dc..de85911 100644
--- a/mail/common/src/main/java/com/fsck/k9/mail/helper/Utf8.kt
+++ b/mail/common/src/main/java/com/fsck/k9/mail/helper/Utf8.kt
@@ -97,7 +97,7 @@ inline fun Int.encodeUtf8(crossinline writeByte: (Byte) -> Unit) {
         // Emit a 11-bit character with 2 bytes.
         writeByte((codePoint shr 6 or 0xc0).toByte()) // 110xxxxx
         writeByte((codePoint and 0x3f or 0x80).toByte()) // 10xxxxxx
-    } else if (codePoint < 0xd800 || codePoint in 0xe000..0x10000) {
+    } else if (codePoint < 0xd800 || codePoint in 0xe000..0xffff) {
         // Emit a 16-bit character with 3 bytes.
         writeByte((codePoint shr 12 or 0xe0).toByte()) // 1110xxxx
         writeByte((codePoint shr 6 and 0x3f or 0x80).toByte()) // 10xxxxxx
diff --git a/mail/common/src/test/java/com/fsck/k9/mail/internet/MimeParameterEncoderTest.kt b/mail/common/src/test/java/com/fsck/k9/mail/internet/MimeParameterEncoderTest.kt
index 5c19672..48473c5 100644
--- a/mail/common/src/test/java/com/fsck/k9/mail/internet/MimeParameterEncoderTest.kt
+++ b/mail/common/src/test/java/com/fsck/k9/mail/internet/MimeParameterEncoderTest.kt
@@ -96,6 +96,15 @@ class MimeParameterEncoderTest {
         )
     }
 
+    @Test
+    fun longParameterValueWithCodePointU10000() {
+        val filename = "\uD800\uDC00".repeat(20) + ".txt"
+
+        val header = MimeParameterEncoder.encode("attachment", mapOf("filename" to filename))
+
+        assertThat(MimeParameterDecoder.decode(header).parameters["filename"]).isEqualTo(filename)
+    }
+
     @Test
     fun parameterValueWithControlCharacter() {
         val header = MimeParameterEncoder.encode(
